---
import { siteContent } from "../data/content";

const { skills } = siteContent;
---

<section id="skills" class="skills-section" aria-labelledby="skills-heading">
  <div class="skills-inner">

    <div class="skills-header reveal">
      <p class="section-eyebrow">Skills</p>
      <span class="accent-rule"></span>
      <h2 id="skills-heading" class="skills-heading">The full stack.</h2>
    </div>

    <!-- Skills: definition list aesthetic, not tag clouds -->
    <dl class="skills-list">
      {skills.map((group, i) => (
        <div class:list={["skill-group", "reveal", `reveal-delay-${Math.min((i % 3) + 1, 6)}`]}>
          <dt class="skill-category">{group.category}</dt>
          <dd class="skill-items">
            {group.items.join(" · ")}
          </dd>
        </div>
      ))}
    </dl>

  </div>
</section>

<style>
  .skills-section {
    padding: 7rem 0;
    background: var(--color-paper);
  }

  .skills-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .skills-header {
    margin-bottom: 4rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 2.5rem;
  }

  .skills-heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    margin-top: 1.25rem;
    line-height: 1.08;
  }

  /* Definition list layout */
  .skills-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 640px) {
    .skills-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .skills-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-group {
    padding: 2rem 2rem 2rem 0;
    border-top: 1px solid var(--color-rule);
  }

  /* Nth-child borders for clean grid look */
  @media (min-width: 640px) {
    .skill-group:nth-child(even) {
      padding-left: 2rem;
      border-left: 1px solid var(--color-rule);
    }
  }

  @media (min-width: 1024px) {
    /* Reset even-child rule */
    .skill-group:nth-child(even) {
      padding-left: 0;
      border-left: none;
    }
    /* 3-column: borders on 2nd and 3rd columns */
    .skill-group:nth-child(3n+2),
    .skill-group:nth-child(3n+3) {
      padding-left: 2rem;
      border-left: 1px solid var(--color-rule);
    }
    .skill-group:nth-child(3n+3) {
      padding-left: 2rem;
    }
  }

  .skill-category {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 0.875rem;
  }

  .skill-category::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2em;
    bottom: 0.2em;
    width: 2px;
    background: var(--color-accent);
  }

  .skill-items {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
