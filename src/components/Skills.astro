---
import { siteContent } from "../data/content";

const { skills } = siteContent;

// Map category names to Font Awesome icons
const categoryIcons: Record<string, string> = {
  "Cloud Platforms & Services": "fab fa-aws",
  "Security & Compliance": "fas fa-shield-alt",
  "DevSecOps & IaC": "fas fa-code-branch",
  "Monitoring & Observability": "fas fa-chart-line",
  "Programming & Scripting": "fas fa-code",
  "Leadership & Communication": "fas fa-users",
  "Systems & Infrastructure": "fas fa-server",
  "Problem Solving & Innovation": "fas fa-lightbulb",
};
---

<section id="skills" class="skills-section" aria-labelledby="skills-heading">
  <div class="site-container">
    <h2 id="skills-heading" class="section-title reveal">Skills &amp; Technologies</h2>

    <div class="skills-grid">
      {skills.map((group, i) => (
        <div
          class:list={["skill-card", "reveal", `reveal-delay-${Math.min((i % 3) + 1, 6)}`]}
        >
          <h3 class="skill-card-title">
            <i class:list={[categoryIcons[group.category] ?? "fas fa-star"]} aria-hidden="true"></i>
            {group.category}
          </h3>
          <div class="skill-tags">
            {group.items.map((item) => (
              <span class="skill-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 6rem 0;
    background: var(--color-bg-primary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }

  @media (min-width: 1100px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  .skill-card-title {
    color: var(--color-secondary);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1.3;
  }

  .skill-card-title i {
    color: var(--color-primary);
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 0.4rem 0.875rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-primary);
    transition: all 0.3s ease;
    cursor: default;
  }

  .skill-tag:hover {
    background: linear-gradient(135deg, #ff9900 0%, #146eb4 100%);
    color: white;
    transform: translateY(-2px);
  }
</style>
