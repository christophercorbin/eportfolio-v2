---
import { siteContent } from "../data/content";
import ContactForm from "./ContactForm";
import Icon from "./Icon.astro";

const { contact } = siteContent;
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="site-container">
    <h2 id="contact-heading" class="section-title reveal">Get In Touch</h2>

    <div class="contact-grid">
      <!-- Info column -->
      <div class="contact-info reveal reveal-delay-1">
        <h3 class="contact-info-title">Let's Connect</h3>
        <p class="contact-intro">
          I'm always interested in discussing new opportunities, cloud architecture challenges,
          and security engineering roles. Open to relocation and willing to travel.
        </p>

        <address class="contact-methods" aria-label="Contact details">
          <div class="contact-method">
            <Icon name="envelope" />
            <a href={`mailto:${contact.email}`} class="contact-link">
              {contact.emailDisplay}
            </a>
          </div>
          <div class="contact-method">
            <Icon name="phone" />
            <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="contact-link">
              {contact.phone}
            </a>
          </div>
          {contact.socials.github && (
            <div class="contact-method">
              <Icon name="github" />
              <a
                href={contact.socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
              >
                {contact.socials.github.replace("https://", "")}
              </a>
            </div>
          )}
          <div class="contact-method">
            <Icon name="location-dot" />
            <span>{contact.location}</span>
          </div>
        </address>
      </div>

      <!-- Contact form -->
      <div class="contact-form-wrap reveal reveal-delay-2">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="site-footer">
  <div class="site-container footer-inner">
    <p class="footer-copy">&copy; 2026 Christopher Corbin. Built with Astro &middot; Deployed on AWS Amplify.</p>
    <div class="footer-links">
      {contact.socials.github && (
        <a href={contact.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="github" />
        </a>
      )}
      <a href={`mailto:${contact.email}`} aria-label="Email">
        <Icon name="envelope" />
      </a>
      <a href={`tel:${contact.phone.replace(/\s/g, "")}`} aria-label="Phone">
        <Icon name="phone" />
      </a>
    </div>
  </div>
</footer>

<style>
  .contact-section {
    padding: 6rem 0 5rem;
    background: var(--color-bg-dark);
    color: white;
  }

  /* Override section-title for dark bg */
  .contact-section .section-title {
    color: white;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Info side */
  .contact-info-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .contact-intro {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-style: normal;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
  }

  .contact-method :global(.icon) {
    color: var(--color-primary);
    height: 1.1em;
    width: 20px;
  }

  .contact-link {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-link:hover {
    color: var(--color-primary);
  }

  /* Form wrapper — the form itself is styled via ContactForm inline styles */
  .contact-form-wrap {
    background: white;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  /* Footer */
  .site-footer {
    background: var(--color-bg-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2rem 0;
    color: white;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  .footer-copy {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.2rem;
    transition: all 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--color-primary);
    transform: translateY(-2px);
  }
</style>
