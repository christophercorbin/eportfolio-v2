---
import { siteContent } from "../data/content";

const { badges } = siteContent.certifications;

const credly = badges.filter((b) => b.credlyId !== null);
const nonCreedly = badges.filter((b) => b.credlyId === null);
---

<section id="certifications" class="certs-section" aria-labelledby="certs-heading">
  <div class="certs-inner">

    <div class="certs-header reveal">
      <p class="section-eyebrow">Credentials</p>
      <span class="accent-rule"></span>
      <h2 id="certs-heading" class="certs-heading">Certifications &amp; qualifications.</h2>
    </div>

    <!-- Credly badges -->
    {credly.length > 0 && (
      <div class="certs-credly reveal reveal-delay-1">
        <p class="certs-sub">Verified badges</p>
        <div class="credly-grid">
          {credly.map((badge) => (
            <div class="credly-badge-wrap" title={badge.name}>
              <div
                data-iframe-width="150"
                data-iframe-height="270"
                data-share-badge-id={badge.credlyId!}
                data-share-badge-host="https://www.credly.com"
              ></div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Non-Credly cards -->
    {nonCreedly.length > 0 && (
      <div class="certs-other reveal reveal-delay-2">
        <p class="certs-sub">Qualifications</p>
        <div class="other-grid">
          {nonCreedly.map((badge) => (
            <div
              class:list={["cert-card", badge.inProgress && "cert-in-progress"]}
              role="listitem"
            >
              {badge.inProgress && (
                <span class="in-progress-badge" aria-label="In progress">In Progress</span>
              )}
              <div class="cert-card-content">
                <p class="cert-name">{badge.name}</p>
                <p class="cert-issuer">{badge.issuer}</p>
                {badge.year && (
                  <p class="cert-year">{badge.year}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<!-- Credly embed script — loaded once -->
<script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>

<style>
  .certs-section {
    padding: 7rem 0;
    background: var(--color-paper-warm);
  }

  .certs-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .certs-header {
    margin-bottom: 4rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 2.5rem;
  }

  .certs-heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    margin-top: 1.25rem;
    line-height: 1.08;
  }

  .certs-sub {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 1.75rem;
  }

  /* Credly grid */
  .certs-credly {
    margin-bottom: 4rem;
  }

  .credly-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .credly-badge-wrap {
    flex-shrink: 0;
  }

  /* Non-credly grid */
  .other-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
  }

  @media (min-width: 640px) {
    .other-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .other-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cert-card {
    background: var(--color-paper-warm);
    padding: 1.75rem 1.5rem;
    position: relative;
    transition: background 0.2s;
  }

  .cert-card:hover {
    background: var(--color-paper);
  }

  .cert-in-progress {
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-paper-warm));
  }

  .in-progress-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.15em 0.5em;
    margin-bottom: 0.875rem;
  }

  .cert-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  .cert-issuer {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--color-ink-muted);
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .cert-year {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ink-faint);
  }
</style>
