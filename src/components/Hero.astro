---
import { siteContent } from "../data/content";

const { hero } = siteContent;
---

<section id="home" class="hero-section" aria-label="Introduction">
  <div class="hero-inner">
    <!-- Left: text content -->
    <div class="hero-text">
      <p class="hero-eyebrow" aria-hidden="true">AWS Solutions Architect &amp; Security Engineer</p>

      <h1 class="hero-name">
        {hero.name.split(" ").map((word, i) => (
          <span class:list={["name-word", i === 1 && "name-accent"]}>{word}</span>
        ))}
      </h1>

      <p class="hero-subtitle">{hero.subtitle}</p>

      <div class="hero-ctas">
        {hero.ctas.map((cta) => (
          <a
            href={cta.href}
            class:list={["hero-cta", cta.primary ? "cta-primary" : "cta-secondary"]}
          >
            {cta.label}
            {cta.primary && <span class="cta-arrow" aria-hidden="true">→</span>}
          </a>
        ))}
      </div>

      <div class="hero-meta" aria-hidden="true">
        <span class="meta-dot"></span>
        <span>Barbados — Open to relocation</span>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="hero-photo-frame" aria-hidden="true">
      <div class="photo-outer">
        <div class="photo-offset-box"></div>
        <div class="photo-container">
          <img
            src={hero.photo}
            alt="Portrait of Christopher Corbin"
            class="photo-img"
            width="420"
            height="520"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <div class="photo-label">
        <span>AWS Certified</span>
        <span class="photo-label-rule"></span>
        <span>CompTIA Sec+</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100svh;
    padding-top: 3.75rem; /* nav height */
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    flex: 1;
    max-width: 72rem;
    margin: 0 auto;
    width: 100%;
    padding: 3.5rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr 420px;
      gap: 4rem;
      padding: 5rem 1.5rem 4rem;
    }
  }

  /* Text side */
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-eyebrow::before {
    content: "";
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .name-word {
    display: block;
  }

  .name-accent {
    color: var(--color-accent);
    padding-left: 0.1em; /* subtle offset */
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-width: 44ch;
    margin-bottom: 2.5rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-primary {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.75rem 1.5rem;
  }

  .cta-primary:hover {
    background: var(--color-accent);
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary {
    color: var(--color-ink-muted);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
  }

  .cta-secondary:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .hero-meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-ink-faint);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .meta-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* Photo side */
  .hero-photo-frame {
    position: relative;
    order: -1;
  }

  @media (min-width: 768px) {
    .hero-photo-frame {
      order: 0;
    }
  }

  .photo-outer {
    position: relative;
    max-width: 380px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .photo-outer {
      max-width: 420px;
      margin: 0;
    }
  }

  .photo-offset-box {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: -1rem;
    bottom: -1rem;
    border: 1.5px solid var(--color-accent);
    z-index: 0;
  }

  .photo-container {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: var(--color-paper-warm);
    aspect-ratio: 4 / 5;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: contrast(1.02) saturate(0.9);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-container:hover .photo-img {
    transform: scale(1.02);
  }

  .photo-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .photo-label-rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  @media (max-width: 767px) {
    .scroll-indicator {
      display: none;
    }
  }

  .scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1.15); }
  }
</style>
