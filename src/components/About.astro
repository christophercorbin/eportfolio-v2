---
import { siteContent } from "../data/content";

const { about } = siteContent;
const bioParagraphs = about.bio.split("\n\n");
---

<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="site-container">
    <h2 id="about-heading" class="section-title reveal">About Me</h2>

    <div class="about-content">
      <!-- Bio -->
      <div class="about-text reveal reveal-delay-1">
        {bioParagraphs.map((para) => (
          <p class="bio-para">{para}</p>
        ))}
      </div>

      <!-- Stats -->
      <div class="about-stats" aria-label="Career highlights">
        {about.stats.map((stat, i) => (
          <div
            class:list={["stat-card", "reveal", `reveal-delay-${i + 2}`]}
            role="listitem"
          >
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 6rem 0;
    background: var(--color-bg-primary);
  }

  .about-content {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .bio-para {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .bio-para:last-of-type {
    margin-bottom: 0;
  }

  /* Stats row */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 600px) {
    .about-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .stat-card {
    text-align: center;
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }
</style>
