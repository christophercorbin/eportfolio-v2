---
import { siteContent } from "../data/content";

const { experience } = siteContent;
---

<section id="experience" class="experience-section" aria-labelledby="experience-heading">
  <div class="exp-inner">

    <div class="exp-header reveal">
      <p class="section-eyebrow">Experience</p>
      <span class="accent-rule"></span>
      <h2 id="experience-heading" class="exp-heading">Where I've built.</h2>
    </div>

    <!-- Timeline -->
    <ol class="timeline" role="list">
      {experience.map((role, i) => (
        <li class:list={["timeline-item", "reveal", `reveal-delay-${Math.min(i + 1, 6)}`]}>
          <!-- Left rail: dates + connector -->
          <div class="timeline-rail" aria-hidden="true">
            <span class="timeline-dates">{role.dates}</span>
            <div class="timeline-connector">
              <div class="timeline-node"></div>
              <div class="timeline-line"></div>
            </div>
          </div>

          <!-- Right: content -->
          <div class="timeline-body">
            <div class="role-header">
              <h3 class="role-company">{role.company}</h3>
              <div class="role-meta">
                <span class="role-title">{role.role}</span>
                <span class="role-sep" aria-hidden="true">·</span>
                <span class="role-location">{role.location}</span>
              </div>
              <!-- Dates visible on mobile -->
              <p class="role-dates-mobile" aria-hidden="true">{role.dates}</p>
            </div>

            <ul class="role-bullets" aria-label={`Responsibilities at ${role.company}`}>
              {role.bullets.map((bullet) => (
                <li class="role-bullet">{bullet}</li>
              ))}
            </ul>

            <div class="role-tech" aria-label={`Technologies used at ${role.company}`}>
              {role.tech.map((t) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .experience-section {
    padding: 7rem 0;
    background: var(--color-paper-warm);
  }

  .exp-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .exp-header {
    margin-bottom: 4rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 2.5rem;
  }

  .exp-heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    margin-top: 1.25rem;
    line-height: 1.08;
  }

  /* Timeline layout */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .timeline-item {
      grid-template-columns: 200px 1fr;
      gap: 2.5rem;
      margin-bottom: 0;
    }

    .timeline-item:last-child .timeline-line {
      display: none;
    }
  }

  /* Rail */
  .timeline-rail {
    display: none;
  }

  @media (min-width: 768px) {
    .timeline-rail {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 0.25rem;
      text-align: right;
      gap: 0.5rem;
    }
  }

  .timeline-dates {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .timeline-connector {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: 1;
    width: 100%;
    position: relative;
  }

  .timeline-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    margin-right: -1.27rem; /* align with gutter */
    position: relative;
    z-index: 1;
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    min-height: 3rem;
    background: var(--color-rule);
    margin-right: -0.85rem;
    margin-top: 0.375rem;
  }

  /* Body */
  .timeline-body {
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 768px) {
    .timeline-body {
      padding-left: 1.5rem;
    }
  }

  .timeline-item:last-child .timeline-body {
    border-bottom: none;
    padding-bottom: 0;
  }

  .role-header {
    margin-bottom: 1.25rem;
  }

  .role-company {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .role-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .role-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-muted);
  }

  .role-sep {
    color: var(--color-rule);
  }

  .role-location {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .role-dates-mobile {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-faint);
    letter-spacing: 0.04em;
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .role-dates-mobile {
      display: none;
    }
  }

  /* Bullets */
  .role-bullets {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .role-bullet {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-ink-muted);
    padding-left: 1.25rem;
    position: relative;
  }

  .role-bullet::before {
    content: "—";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    line-height: 1.85;
  }

  /* Tech chips */
  .role-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }
</style>
