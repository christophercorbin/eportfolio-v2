---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent } from "../data/content";

const { contact, about, experience, skills, certifications } = siteContent;
const description =
  "Resume of Christopher Corbin — AWS Solutions Architect & Security Engineer specializing in secure cloud architectures, DevOps automation, and SOC 2 compliance.";
---

<BaseLayout title="Christopher Corbin — Resume" description={description}>
  <div
    class="min-h-screen bg-paper print:bg-white px-6 py-10 md:px-12 md:py-14 print:px-0 print:py-0 print:before:hidden"
  >
    <!-- ── HEADER ────────────────────────────────────────────────────── -->
    <header class="mb-8 print:mb-5">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 print:flex-row print:items-end print:justify-between">
        <div>
          <h1
            class="font-display text-5xl font-bold tracking-tight text-ink leading-none mb-1 print:text-4xl"
          >
            Christopher Corbin
          </h1>
          <p class="font-body text-base text-ink-muted font-light tracking-wide print:text-sm">
            AWS Solutions Architect &amp; Security Engineer
          </p>
        </div>

        <!-- Download button — hidden on print -->
        <a
          href="/assets/Christopher_Corbin_Resume.pdf"
          download
          class="print:hidden inline-flex items-center gap-2 bg-accent text-white font-body text-sm font-medium px-5 py-2.5 hover:bg-accent-hover transition-colors duration-200 self-start sm:self-auto"
          style="border-radius: 1px;"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download PDF
        </a>
      </div>

      <!-- Accent rule -->
      <div class="mt-4 mb-4 h-px bg-rule print:bg-black/20"></div>

      <!-- Contact row -->
      <div class="flex flex-wrap gap-x-6 gap-y-1 font-body text-xs text-ink-muted print:text-[10px]">
        <a href={`mailto:${contact.email}`} class="hover:text-accent transition-colors">
          {contact.email}
        </a>
        <span>{contact.phone}</span>
        <span>{contact.location}</span>
        {
          contact.socials.github && (
            <a
              href={contact.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent transition-colors print:text-ink-muted"
            >
              {contact.socials.github.replace("https://", "")}
            </a>
          )
        }
      </div>
    </header>

    <!-- ── TWO-COLUMN BODY ───────────────────────────────────────────── -->
    <div
      class="grid grid-cols-1 md:grid-cols-[270px_1fr] print:grid-cols-[220px_1fr] gap-x-10 gap-y-10 print:gap-x-7 print:gap-y-0 items-start"
    >
      <!-- ── LEFT SIDEBAR ─────────────────────────────────────────────── -->
      <aside class="space-y-8 print:space-y-5">
        <!-- Summary -->
        <section>
          <p class="section-eyebrow mb-2">Summary</p>
          <span class="accent-rule"></span>
          <div class="font-body text-xs leading-relaxed text-ink-muted print:text-[10px] print:text-black/70 space-y-3">
            {
              about.bio.split("\n\n").map((para) => (
                <p>{para}</p>
              ))
            }
          </div>
        </section>

        <!-- Skills -->
        <section>
          <p class="section-eyebrow mb-2">Skills</p>
          <span class="accent-rule"></span>
          <div class="space-y-4 print:space-y-2.5">
            {
              skills.map((skillGroup) => (
                <div class="print:break-inside-avoid">
                  <p class="font-body text-[10px] font-semibold uppercase tracking-widest text-ink-faint mb-1 print:text-[8px]">
                    {skillGroup.category}
                  </p>
                  <p class="font-body text-xs text-ink-muted leading-relaxed print:text-[10px] print:text-black/70">
                    {skillGroup.items.join(" · ")}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Certifications -->
        <section>
          <p class="section-eyebrow mb-2">Certifications</p>
          <span class="accent-rule"></span>
          <div class="space-y-3 print:space-y-2">
            {
              certifications.badges.map((cert) => (
                <div class="print:break-inside-avoid">
                  <p class="font-body text-xs font-semibold text-ink leading-snug print:text-[10px] print:text-black">
                    {cert.name}
                    {cert.inProgress && (
                      <span class="text-accent font-normal text-[10px] ml-1">
                        (in progress)
                      </span>
                    )}
                  </p>
                  <p class="font-body text-[10px] text-ink-muted print:text-[9px] print:text-black/60">
                    {cert.issuer}
                    {cert.year && (
                      <span class="text-ink-faint ml-1.5">· {cert.year}</span>
                    )}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
      </aside>

      <!-- ── RIGHT MAIN COLUMN ─────────────────────────────────────────── -->
      <main>
        <p class="section-eyebrow mb-2">Experience</p>
        <span class="accent-rule"></span>

        <div class="space-y-8 print:space-y-5">
          {
            experience.map((job) => (
              <article class="print:break-inside-avoid">
                <!-- Company + meta -->
                <div class="mb-2">
                  <h2 class="font-display text-lg font-bold text-ink leading-tight print:text-base print:text-black">
                    {job.company}
                  </h2>
                  <div class="flex flex-wrap items-baseline gap-x-3 mt-0.5">
                    <span class="font-body text-sm font-medium text-ink-muted print:text-xs print:text-black/70">
                      {job.role}
                    </span>
                    <span class="font-body text-xs text-ink-faint print:text-[10px] print:text-black/50">
                      {job.dates} · {job.location}
                    </span>
                  </div>
                </div>

                <div class="h-px bg-rule mb-3 print:bg-black/15"></div>

                <!-- Bullets -->
                <ul class="space-y-1.5 mb-3 print:space-y-1">
                  {job.bullets.map((bullet) => (
                    <li class="flex gap-2 font-body text-sm text-ink-muted leading-snug print:text-[10.5px] print:text-black/75">
                      <span
                        class="mt-1.5 shrink-0 w-1 h-1 rounded-full bg-accent print:bg-black/40"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <!-- Tech chips -->
                <div class="flex flex-wrap gap-1.5">
                  {job.tech.map((tag) => (
                    <span class="tech-chip print:border-black/20 print:text-black/60">
                      {tag}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </main>
    </div>

    <!-- Footer rule on screen only -->
    <div class="mt-12 h-px bg-rule print:hidden"></div>
    <p class="print:hidden mt-4 font-body text-xs text-ink-faint text-center">
      christophercorbin.cloud
    </p>
  </div>
</BaseLayout>

<style>
  @media print {
    body::before {
      display: none !important;
    }

    @page {
      margin: 0.75in;
      size: letter;
    }

    body {
      background: white !important;
      font-size: 11px;
    }
  }
</style>
