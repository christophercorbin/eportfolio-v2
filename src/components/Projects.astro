---
import { siteContent } from "../data/content";
import Icon from "./Icon.astro";
import type { IconName } from "./icon-names";

const { projects } = siteContent;

// Project icons (order matches siteContent.projects)
const projectIcons: IconName[] = [
  "lightbulb",        // MathMentor
  "cloud",            // Hurricane-Ready
  "building-columns", // Landing Zone
  "code-branch",      // Delivery Pipeline
  "shield-halved",    // SOC2 ML Analyzer
  "server",           // This site
];
---

<section id="projects" class="projects-section" aria-labelledby="projects-heading">
  <div class="site-container">
    <h2 id="projects-heading" class="section-title reveal">Featured Projects</h2>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <div class:list={["project-card", "reveal", `reveal-delay-${Math.min(i + 1, 6)}`]}>
          <!-- Gradient header with icon -->
          <div class="project-image">
            <Icon name={projectIcons[i] ?? "code"} size={3} />
            <span class:list={["project-badge", "live" in project.links && "project-badge-live"]}>
              {"live" in project.links ? "Live Demo" : "Open Source"}
            </span>
          </div>

          <!-- Content -->
          <div class="project-content">
            <h3 class="project-title">{project.title}</h3>
            <p class="project-description">{project.description}</p>

            <div class="project-tech" aria-label={`Technologies: ${project.tech.join(", ")}`}>
              {project.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>

            <div class="project-links">
              <a
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                aria-label={`View ${project.title} on GitHub`}
              >
                <Icon name="github" /> View Code
              </a>
              {"live" in project.links && project.links.live && (
                <a
                  href={project.links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link project-link-live"
                  aria-label={`Open the live ${project.title} demo`}
                >
                  <Icon name="external-link" /> Live Demo
                </a>
              )}
              {"demo" in project.links && project.links.demo &&
                (project.links.demo as string) !== (project.links.github as string) && (
                <a
                  href={project.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  aria-label={`View ${project.title} documentation`}
                >
                  <Icon name="external-link" /> Documentation
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 0;
    background: var(--color-bg-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18);
  }

  /* Gradient image header */
  .project-image {
    background: linear-gradient(135deg, #ff9900 0%, #146eb4 100%);
    padding: 3rem;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .project-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-secondary);
    padding: 0.25rem 0.6rem;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    animation: pulse-badge 2s infinite;
  }

  .project-badge-live {
    background: #16a34a;
    color: #ffffff;
  }

  .project-link-live {
    color: var(--color-secondary);
    font-weight: 700;
  }

  @keyframes pulse-badge {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50%       { opacity: 1; transform: scale(1.04); }
  }

  /* Content */
  .project-content {
    padding: 2rem;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.875rem;
    color: var(--color-secondary);
    line-height: 1.3;
  }

  .project-description {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    background: var(--color-bg-secondary);
    padding: 0.3rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    color: var(--color-text-primary);
    font-weight: 500;
    cursor: default;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: all 0.3s ease;
  }

  .project-link:hover {
    color: var(--color-accent);
    transform: translateX(3px);
  }
</style>
