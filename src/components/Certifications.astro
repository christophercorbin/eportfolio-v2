---
import { siteContent } from "../data/content";
import Icon from "./Icon.astro";

const { badges } = siteContent.certifications;

// Separate main certs (non-Cisco) from Cisco badges
const mainCerts = badges.filter((b) => b.issuer !== "Cisco");
const ciscoCerts = badges.filter((b) => b.issuer === "Cisco");
---

<section id="certifications" class="certs-section" aria-labelledby="certs-heading">
  <div class="site-container">
    <h2 id="certs-heading" class="section-title reveal">Certifications &amp; Education</h2>

    <!-- Main certifications grid -->
    <div class="certs-grid">
      {mainCerts.map((cert, i) => (
        <div
          class:list={["cert-card", cert.inProgress && "cert-in-progress", "reveal", `reveal-delay-${Math.min(i + 1, 6)}`]}
          role="listitem"
        >
          <!-- Badge area -->
          <div class="cert-badge-area">
            {cert.credlyId ? (
              <div class="credly-wrap">
                <div
                  data-iframe-width="120"
                  data-iframe-height="220"
                  data-share-badge-id={cert.credlyId}
                  data-share-badge-host="https://www.credly.com"
                ></div>
              </div>
            ) : cert.name.includes("Cybersecurity") ? (
              <div class="custom-badge cybersec-badge">
                <Icon name="user-shield" size={2} />
              </div>
            ) : cert.name.includes("BSc") || cert.name.includes("Computer Science") ? (
              <div class="custom-badge education-badge">
                <Icon name="graduation-cap" size={2} />
              </div>
            ) : cert.inProgress ? (
              <div class="custom-badge inprogress-badge">
                <img
                  src="https://images.credly.com/size/340x340/images/bd31ef42-d460-493e-8503-39592aaf0458/image.png"
                  alt="AWS DevOps Engineer Professional Badge"
                  class="badge-img"
                />
              </div>
            ) : (
              <div class="custom-badge default-badge">
                <Icon name="certificate" size={2} />
              </div>
            )}
          </div>

          <!-- Content -->
          <div class="cert-content">
            {cert.inProgress && (
              <span class="in-progress-badge" aria-label="In progress">In Progress</span>
            )}
            <h3 class="cert-name">{cert.name}</h3>
            <p class="cert-issuer">{cert.issuer}</p>
            {cert.year && (
              <span class:list={["cert-year", cert.inProgress && "cert-year-progress"]}>
                {cert.year}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Cisco badges section -->
    {ciscoCerts.length > 0 && (
      <div class="cisco-section reveal reveal-delay-2">
        <h3 class="cisco-title">Cisco Networking &amp; Cybersecurity Badges</h3>
        <div class="cisco-grid">
          {ciscoCerts.map((cert) => (
            <div class="cisco-card">
              <div
                data-iframe-width="150"
                data-iframe-height="270"
                data-share-badge-id={cert.credlyId!}
                data-share-badge-host="https://www.credly.com"
              ></div>
              <span class="cisco-label">{cert.name}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- Credly embed script -->
<script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>

<style>
  .certs-section {
    padding: 6rem 0;
    background: var(--color-bg-primary);
  }

  /* Main certs grid */
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }

  .cert-card {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .cert-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  /* In-progress shimmer */
  .cert-in-progress {
    border: 2px solid var(--color-primary);
  }

  .cert-in-progress::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 153, 0, 0.08), transparent);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0%   { left: -100%; }
    100% { left: 100%; }
  }

  /* Badge area */
  .cert-badge-area {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .credly-wrap {
    width: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .custom-badge {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: transform 0.3s ease;
  }

  .custom-badge:hover {
    transform: scale(1.1);
  }

  .cybersec-badge {
    background: linear-gradient(135deg, #dc3545 0%, #6f42c1 100%);
  }

  .education-badge {
    background: linear-gradient(135deg, #28a745 0%, #007bff 100%);
  }

  .inprogress-badge {
    background: transparent;
    width: 80px;
    height: 80px;
  }

  .default-badge {
    background: linear-gradient(135deg, #ff9900 0%, #146eb4 100%);
  }

  .badge-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    opacity: 0.75;
    filter: grayscale(20%);
  }

  /* Content */
  .cert-content {
    flex: 1;
  }

  .in-progress-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ff9900 0%, #146eb4 100%);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 10px;
    margin-bottom: 0.5rem;
    animation: pulse-badge 2s infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.75; }
  }

  .cert-name {
    color: var(--color-secondary);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    line-height: 1.35;
  }

  .cert-issuer {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .cert-year {
    display: inline-block;
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cert-year-progress {
    background: linear-gradient(135deg, #ff9900 0%, #146eb4 100%);
    color: white;
  }

  /* Responsive cert cards */
  @media (max-width: 480px) {
    .cert-card {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Cisco section */
  .cisco-section {
    margin-top: 2rem;
    padding-top: 2.5rem;
    border-top: 2px solid var(--color-bg-secondary);
  }

  .cisco-title {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 2rem;
  }

  .cisco-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .cisco-card {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cisco-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  }

  .cisco-label {
    display: block;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
  }
</style>
